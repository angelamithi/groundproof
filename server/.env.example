# --- Shared with the app (same names) ---
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PACKAGE_ID=
NEXT_PUBLIC_CONFIG_ID=
NEXT_PUBLIC_REGISTRY_ID=
NEXT_PUBLIC_COIN_TYPE=
NEXT_PUBLIC_COIN_DECIMALS=6
NEXT_PUBLIC_COIN_SYMBOL=USDC
NEXT_PUBLIC_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_SEAL_KEY_SERVERS=

# --- Server only ---
PORT=8787
PUBLIC_URL=http://localhost:8787
DB_PATH=./groundproof.db

# Platform operator key (suiprivkey…). Register its address as a verifier:
#   reputation::add_verifier(AdminCap, Registry, <operator address>)
OPERATOR_PRIVATE_KEY=

# 64 hex characters. Encrypts agent wallet keys at rest. Back it up; losing it
# loses access to agent wallets. Generate with: openssl rand -hex 32
MASTER_KEY=

# Long random string for the /admin endpoints (create API keys). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional: sponsor gas for agent wallets and the operator via Enoki
ENOKI_PRIVATE_KEY=

INDEXER_INTERVAL_MS=4000
JOBS_INTERVAL_MS=60000
